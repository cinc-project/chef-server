<!DOCTYPE html>
<html class="no-js" lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cinc Server Identity</title>
  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_include_tag '//cdnjs.cloudflare.com/ajax/libs/modernizr/2.8.3/modernizr.min.js' %>
  <%= csrf_meta_tags %>
  <%= favicon_link_tag asset_path('favicon.ico') %>
  <%= render 'application/analytics' %>
</head>
<body>
  <div class="contain-to-grid">
    <nav class="top-bar" data-topbar role="navigation">
      <ul class="title-area">
        <li class="name">
          <h1>
            <%= link_to root_path, :class => 'brand' do %>
              <%= image_tag 'cinc-logo.png', :alt => '', :class => 'brand-mark' %>
              <span>Cinc Server</span>
            <% end %>
          </h1>
        </li>
        <li class="toggle-topbar menu-icon"><a href="#"><span></span></a></li>
      </ul>
      <div class="top-bar-section main">
        <ul class="left">
          <% if signed_in? %>
            <li><%= link_to "Signed in as: #{current_user.username}", profile_path %></li>
            <% if User.admin?(current_user.username) %>
              <li><%= link_to 'Applications', oauth_applications_path %></li>
            <% end %>
            <li><%= link_to 'Authorized Applications', oauth_authorized_applications_path %></li>
            <li><%= link_to "Sign Out", signout_path, method: "delete" %></li>
          <% else %>
            <li><%= link_to "Sign In", signin_path %></li>
          <% end %>
        </ul>
      </div>
    </nav>
  </div>
  <div class="row">
    <% flash.each do |key, value| %>
      <div data-alert class="alert-box radius <%= chef_class_for(key) %>">
        <%= value %>
        <a href="#" class="close">&times;</a>
      </div>
    <% end %>
    <%= yield %>
  </div>
  <footer>
    <center>
      Cinc Server, a community distribution built by the
      <a href="https://cinc.sh">Cinc Project</a> from Apache-2.0 source.
      <br>
      Chef and the Chef logo are trademarks of their owner; the Cinc Project
      is not affiliated with or endorsed by them.
    </center>
  </footer>
  <%= javascript_include_tag "application" %>
  <script>
    $(document).chef({
      assets: {
        images: '<%= Rails.application.config.assets.prefix %>'
      }
    });
  </script>
</body>
</html>
