source "https://rubygems.org"
source "https://rubygems.cinc.sh"

gemspec

gem "rest-client", git: "https://github.com/chef/rest-client", branch: "jfm/ucrt_update1"

gem "toml" # for habitat-land

gem "knife-ec-backup", "~> 3.0.5"

# public_suffix 7.0+ requires Ruby >= 3.2; pin for Ruby 3.1 compatibility
# (carried from upstream 15.10.114; chef-server-ctl runs on Ruby 3.1)
gem "public_suffix", "< 7.0"

# Cinc gems come from rubygems.cinc.sh (declared as a second global source
# above) and their transitive deps from rubygems.org. A scoped `source` block
# does not work here: chef pulls deps (e.g. unf_ext) that live only on
# rubygems.org, which a block would force to resolve from cinc.sh.
# Version lock chef/knife to match Gemfile.lock when doing a stable release
if ENV['CHANNEL'] =~ /stable|unstable|current/
  gem "chef", "= 18.10.17"
  gem "knife", "~> 18.10.18"
else
  gem "chef", "~> 18.10"
  gem "knife", "~> 18.10.18"
end

gem "chef_backup"
gem "mixlib-install"
gem "inspec-core"
gem "chef-zero", source: "https://rubygems.cinc.sh"
