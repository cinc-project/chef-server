#!/bin/bash

# dpkg will call us with abort-upgrade if the preinst script failed.
# Our preinst script purposefully fails based on user input.
if [[ "$1" = "abort-upgrade" ]]; then
    exit 0
fi

# Only remove the ctl symlinks on a real removal, never on an upgrade.
# dpkg passes words ("remove"/"purge" on removal, "upgrade" on upgrade);
# rpm passes a count ("0" on removal, "1" on upgrade). On rpm the old
# package's %postun runs AFTER the new package's %post, so running these
# rm's during an upgrade deletes the links the new package just created.
# (See also: http://tickets.opscode.com/browse/CHEF-3022)
if [[ "$1" == "remove" || "$1" == "purge" || "$1" == "0" ]]; then
  rm -f /usr/bin/chef-server-ctl
  rm -f /usr/bin/cinc-server-ctl
  rm -f /usr/bin/private-chef-ctl
  rm -f /usr/bin/private-cinc-ctl
fi
